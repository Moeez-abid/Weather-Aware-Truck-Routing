# Copy to .env and fill in real values. Never commit .env.

# Backend
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
# On Vercel the deployment's own vercel.app hostnames are added automatically.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# In production, the frontend's Vercel address, such as https://clearhaul.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173
TOMTOM_API_KEY=your-tomtom-api-key

# Frontend. In production, the backend's Vercel address, such as https://clearhaul-api.vercel.app
VITE_API_BASE_URL=http://localhost:8000
